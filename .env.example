# 1. LIVE MYSQL DATABASE (From GoDaddy cPanel MySQL Databases)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_godaddy_db_username
DB_PASSWORD=your_godaddy_db_password
DB_NAME=your_godaddy_db_name

# 2. APPLICATION PRODUCTION URL
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NODE_ENV=production

# 3. AUTHENTICATION & SECURITY (Random 64+ char secret string)
AUTH_SECRET=fccglobal_production_super_secure_key_2026_london_education_portal_auth_secret_token_8392183

# 4. GODADDY / CUSTOM DOMAIN SMTP EMAIL (Optional - can also be set directly in Admin Panel)
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_USER=admissions@yourdomain.com
SMTP_PASS=your_email_password
SMTP_FROM=admissions@yourdomain.com
SMTP_FROM_NAME="FCC Global Education"

# 5. AI CHATBOT GROQ API KEY (Optional - can also be set in Admin Panel)
GROQ_API_KEY=
